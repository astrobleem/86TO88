+            if n==3000 { emu.machine.emit_key_sequence(&[K::AltLeft,K::KeyF]); }
+            if n==3020 { emu.machine.emit_key_sequence(&[K::KeyR]); }
+            if n>=3040 && n<3040+keys.len() as u32*20 && (n-3040)%20==0 { let i=((n-3040)/20) as usize; emu.machine.emit_key_sequence(&[keys[i]]); }
+            if n==3400 { emu.machine.emit_key_sequence(&[K::Enter]); }
+            if n==4000 { save_frame(&mut emu.machine,"initial.ppm"); }
+            if std::env::var("MARTY_MOUSE").is_ok() {
+                use marty_core::devices::mouse::MouseInput;
+                let pos = match n { 4050 => Some((-1200.0,-1200.0,false)), 4100 => Some((420.0,100.0,false)), 4200 => Some((0.0,0.0,true)), 4250 => Some((0.0,0.0,false)), _ => None };
+                if let Some((x,y,b))=pos { if let Some(m)=emu.machine.mouse_mut() { m.submit_input(MouseInput { delta_x:x, delta_y:y, left_button:b, ..Default::default() }); } }
+                if n==4150 { save_frame(&mut emu.machine,"mouse-position.ppm"); }
+            } else if n==4100 { emu.machine.emit_key_sequence(&[K::F2]); }
+            if n==4350 { save_frame(&mut emu.machine,"after-f2.ppm"); }
+            if n==4400 { emu.machine.emit_key_sequence(&[K::AltLeft,K::F4]); }
+            if n==4700 { save_frame(&mut emu.machine,"after-exit.ppm"); }
+        }
+        emu.machine.run(100_000, &mut exec);
+        if n % 500 == 0 { eprintln!("MARTY_BATCH {}", n); }
+    }
+    save_frame(&mut emu.machine,"frame.ppm");
     std::process::exit(0);
 }
+
+fn save_frame(machine: &mut marty_core::machine::Machine, name: &str) {
+ use std::io::Write;
+ if let Some(vc) = machine.primary_videocard() {
+  let ext=vc.display_extents(); let w=ext.row_stride; let buf=vc.display_buf(); let h=buf.len()/w;
+  let mut out=std::fs::File::create(name).unwrap();write!(out,"P6\n{} {}\n255\n",w,h).unwrap();
+  let pal:[[u8;3];16]=[[0,0,0],[0,0,170],[0,170,0],[0,170,170],[170,0,0],[170,0,170],[170,85,0],[170,170,170],[85,85,85],[85,85,255],[85,255,85],[85,255,255],[255,85,85],[255,85,255],[255,255,85],[255,255,255]];
+  for y in 0..h { for x in 0..w { let i=y*w+x; let c=buf.get(i).copied().unwrap_or(0) as usize & 15; out.write_all(&pal[c]).unwrap(); } }
+  eprintln!("SAVED {} {}x{}",name,w,h);
+ }
+}
