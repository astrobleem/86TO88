+                        "a"=>K::KeyA,"b"=>K::KeyB,"c"=>K::KeyC,"d"=>K::KeyD,"e"=>K::KeyE,"f"=>K::KeyF,"g"=>K::KeyG,"h"=>K::KeyH,"i"=>K::KeyI,"j"=>K::KeyJ,"k"=>K::KeyK,"l"=>K::KeyL,"m"=>K::KeyM,"n"=>K::KeyN,"o"=>K::KeyO,"p"=>K::KeyP,"q"=>K::KeyQ,"r"=>K::KeyR,"s"=>K::KeyS,"t"=>K::KeyT,"u"=>K::KeyU,"v"=>K::KeyV,"w"=>K::KeyW,"x"=>K::KeyX,"y"=>K::KeyY,"z"=>K::KeyZ,_=>panic!("unknown key {}",v)
+                    }).collect(); emu.machine.emit_key_sequence(&keys);
+                },
+                "mouse" => { use marty_core::devices::mouse::MouseInput; if let Some(m)=emu.machine.mouse_mut() { m.submit_input(MouseInput {delta_x:a[1].parse().unwrap(),delta_y:a[2].parse().unwrap(),left_button:a.get(3)==Some(&"1"),..Default::default()}); } },
+                "shot" => save_frame(&mut emu.machine,a.get(1).unwrap_or(&"repl.ppm")),
+                "quit" => break,
+                _ => eprintln!("UNKNOWN COMMAND")
+            }
+            eprintln!("REPL cycles={} instructions={} error={:?}",emu.machine.cpu_cycles(),emu.machine.cpu_instructions(),emu.machine.get_error_str());
+            std::io::stdout().flush().unwrap();
+        }
+        return;
+    }
+    let batches: u32 = std::env::var("MARTY_BATCHES").ok().and_then(|s| s.parse().ok()).unwrap_or(4800);
+    let game = std::env::var("MARTY_GAME").unwrap_or_default().to_uppercase();
+    let keys: Vec<K> = game.chars().filter_map(|ch| match ch {
+        'A'=>Some(K::KeyA),'B'=>Some(K::KeyB),'C'=>Some(K::KeyC),'D'=>Some(K::KeyD),'E'=>Some(K::KeyE),'F'=>Some(K::KeyF),'G'=>Some(K::KeyG),'H'=>Some(K::KeyH),'I'=>Some(K::KeyI),'J'=>Some(K::KeyJ),'K'=>Some(K::KeyK),'L'=>Some(K::KeyL),'M'=>Some(K::KeyM),'N'=>Some(K::KeyN),'O'=>Some(K::KeyO),'P'=>Some(K::KeyP),'Q'=>Some(K::KeyQ),'R'=>Some(K::KeyR),'S'=>Some(K::KeyS),'T'=>Some(K::KeyT),'U'=>Some(K::KeyU),'V'=>Some(K::KeyV),'W'=>Some(K::KeyW),'X'=>Some(K::KeyX),'Y'=>Some(K::KeyY),'Z'=>Some(K::KeyZ),_=>None }).collect();
+    for n in 0..batches {
