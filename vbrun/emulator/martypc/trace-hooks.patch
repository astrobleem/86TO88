+// Debug write-watch: MARTY_WW="lo-hi" (hex flat addresses) logs every CPU memory write in range.
+static WW_RANGE: std::sync::OnceLock<Option<(u32, u32)>> = std::sync::OnceLock::new();
+static WW_EXCL: std::sync::OnceLock<Vec<u16>> = std::sync::OnceLock::new();
+#[inline]
+fn ww_check(addr: u32, cs: u16, ip: u16, val: u16, size: u8, icount: u64) -> bool {
+    let r = WW_RANGE.get_or_init(|| {
+        std::env::var("MARTY_WW").ok().and_then(|v| {
+            let mut it = v.split('-');
+            let lo = u32::from_str_radix(it.next()?.trim(), 16).ok()?;
+            let hi = u32::from_str_radix(it.next()?.trim(), 16).ok()?;
+            Some((lo, hi))
+        })
+    });
+    if let Some((lo, hi)) = r {
+        if addr + size as u32 > *lo && addr <= *hi {
+            let ex = WW_EXCL.get_or_init(|| std::env::var("MARTY_WW_EXCL").ok().map(|v| v.split(',').filter_map(|x| u16::from_str_radix(x.trim(), 16).ok()).collect()).unwrap_or_default());
+            if ex.contains(&cs) { return false; }
+            eprintln!("WW {:05X} {:04X}:{:04X} = {:04X} sz{} i{}", addr, cs, ip, val, size, icount);
+            return true;
+        }
+    }
+    false
+}
+
+static WV_VAL: std::sync::OnceLock<u16> = std::sync::OnceLock::new();
+fn wv_val() -> u16 { *WV_VAL.get_or_init(|| std::env::var("MARTY_WV").ok().and_then(|v| u16::from_str_radix(v.trim(), 16).ok()).unwrap_or(0)) }
+impl NecVx0 {
+    fn wv_check(&mut self, addr: u32, b: u8) {
+        let v = wv_val(); if v == 0 { return; }
+        if b == (v >> 8) as u8 && addr > 0 {
+            if self.bus.peek_u8(((addr - 1) & 0xFFFFF) as usize).unwrap_or(0) == (v & 0xFF) as u8 {
+                eprintln!("WV {:05X} {:04X}:{:04X} b i{}", addr - 1, self.cs, self.instruction_ip, self.instruction_count);
+                self.ww_context();
+            }
+        }
+    }
+}
+static WW_CTX_LAST: std::sync::atomic::AtomicU64 = std::sync::atomic::AtomicU64::new(u64::MAX);
+impl NecVx0 {
+    fn ww_context(&mut self) {
+        if WW_CTX_LAST.swap(self.instruction_count, std::sync::atomic::Ordering::Relaxed) == self.instruction_count { return; }
+        let ss = self.ss as usize; let bp = self.bp as usize; let sp = self.sp as usize;
+        let mut st = String::new();
+        for k in 0..24usize {
+            let a = (ss << 4) + ((sp + 2 * k) & 0xFFFF);
+            let lo = self.bus.peek_u8(a & 0xFFFFF).unwrap_or(0) as u16; let hi = self.bus.peek_u8((a + 1) & 0xFFFFF).unwrap_or(0) as u16;
+            st.push_str(&format!("{:04X} ", lo | (hi << 8)));
+        }
+        eprintln!("WWCTX CS:{:04X} DS:{:04X} ES:{:04X} SS:{:04X} SP:{:04X} BP:{:04X} SI:{:04X} DI:{:04X} CX:{:04X} AX:{:04X} | {}",
+            self.cs, self.ds, self.es, self.ss, self.sp, self.bp, self.si, self.di, self.c.x(), self.a.x(), st);
+        let _ = bp;
+    }
+}
