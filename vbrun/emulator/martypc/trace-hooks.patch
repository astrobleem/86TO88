+                        if let (Some(sg), Some(of)) = (so.next(), so.next()) {
+                            if let (Ok(sg), Ok(of)) = (u32::from_str_radix(sg, 16), u32::from_str_radix(of, 16)) {
+                                v.push((((sg << 4) + of) & 0xFFFFF, name));
+                            }
+                        }
+                    }
+                }
+            }
+            v
+        });
+        if set.is_empty() { return; }
+        {
+            let mut p = XW_PENDING.lock().unwrap();
+            // innermost pending call on this stack whose return address this is: same SS,
