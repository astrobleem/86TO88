+                let _ = std::fs::write(&ps.2, &v);
+                eprintln!("DUMPED {} at i{} CS:IP {:04X}:{:04X} SS:SP {:04X}:{:04X} BP:{:04X}", ps.2, self.instruction_count, self.cs, self.ip(), self.ss, self.sp, self.bp);
+            }
+        }
+        let set = XW_SET.get_or_init(|| {
+            let mut v = Vec::new();
+            if let Ok(s) = std::env::var("MARTY_XW") {
+                for item in s.split(',') {
+                    let mut kv = item.splitn(2, '=');
