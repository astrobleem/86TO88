+// Debug exec-watch: MARTY_XW="name=SSSS:OOOO,..." logs entry (regs + stack) and the matching far return (AX/DX).
+static XW_SET: std::sync::OnceLock<Vec<(u32, String)>> = std::sync::OnceLock::new();
+// pending watched calls: (return linear address, name, SS, SP at entry, sequence id)
+/// Pick the pending watched call that a fetch at `addr` (SS:SP current) returns from.
+/// A call that has returned has popped its return address, so its entry SP (pointing at
+/// that address) is strictly below the current SP; among those on this stack the innermost
+/// (highest entry SP) wins.  `<=` would let a frameless recursive return whose SP equals
+/// an ancestor's entry SP close the ancestor instead of the inner call.
+pub(crate) fn xw_match(p: &[(u32, String, u16, u16, u64)], addr: u32, ss: u16, sp: u16) -> Option<usize> {
+    let mut best: Option<usize> = None;
+    for (i, e) in p.iter().enumerate() {
+        if e.0 == addr && e.2 == ss && e.3 < sp && best.map_or(true, |b| e.3 >= p[b].3) { best = Some(i); }
+    }
+    best
+}
+#[cfg(test)]
+mod xw_match_tests {
+    use super::xw_match;
+    fn e(addr: u32, sp: u16, id: u64) -> (u32, String, u16, u16, u64) { (addr, "F".into(), 0x3FC1, sp, id) }
+    #[test]
+    fn frameless_recursion_closes_inner_call() {
+        // outer F entered at SP 0x100 (return to A); F calls itself without a frame from
+        // SP 0x0FC: entry SP 0x0FC, retf 0 -> SP 0x100 == outer entry SP.
+        let p = vec![e(0xA, 0x100, 1), e(0xA, 0x0FC, 2)];
+        assert_eq!(xw_match(&p, 0xA, 0x3FC1, 0x100).map(|i| p[i].4), Some(2));
+    }
+    #[test]
+    fn outer_return_after_inner() {
+        let p = vec![e(0xA, 0x100, 1)];
+        assert_eq!(xw_match(&p, 0xA, 0x3FC1, 0x104), Some(0));
+    }
+    #[test]
+    fn not_returned_yet_or_other_stack() {
+        let p = vec![e(0xA, 0x100, 1)];
+        assert_eq!(xw_match(&p, 0xA, 0x3FC1, 0x100), None);
+        assert_eq!(xw_match(&p, 0xA, 0x1234, 0x104), None);
+        assert_eq!(xw_match(&p, 0xB, 0x3FC1, 0x104), None);
+    }
+    #[test]
+    fn nested_with_args_picks_innermost() {
+        // outer entered at 0x200, inner (retf 6) at 0x1F0 -> returns at 0x1F4+6=0x1FA
+        let p = vec![e(0xA, 0x200, 1), e(0xA, 0x1F0, 2)];
+        assert_eq!(xw_match(&p, 0xA, 0x3FC1, 0x1FA).map(|i| p[i].4), Some(2));
+    }
+}
+static XW_PENDING: std::sync::Mutex<Vec<(u32, String, u16, u16, u64)>> = std::sync::Mutex::new(Vec::new());
+static XW_SEQ: std::sync::atomic::AtomicU64 = std::sync::atomic::AtomicU64::new(0);
+impl NecVx0 {
+    pub(crate) fn xw_check(&mut self, addr: u32) {
+        {
+            static PS: std::sync::OnceLock<(u64, u64, String)> = std::sync::OnceLock::new();
+            static PW: std::sync::OnceLock<(u64, u64)> = std::sync::OnceLock::new();
+            let pw = PW.get_or_init(|| (
+                std::env::var("MARTY_PC_FROM").ok().and_then(|v| v.parse().ok()).unwrap_or(0),
+                std::env::var("MARTY_PC_TO").ok().and_then(|v| v.parse().ok()).unwrap_or(0)));
+            {
+                // MARTY_RING=N:LO[:HI]  keep the last N instructions; print them once when LO <= CS < HI
+                static RG: std::sync::OnceLock<(usize, u16, u16)> = std::sync::OnceLock::new();
+                static RB: std::sync::Mutex<(Vec<[u16; 13]>, Vec<u64>, usize, bool)> = std::sync::Mutex::new((Vec::new(), Vec::new(), 0, false));
+                let rg = RG.get_or_init(|| std::env::var("MARTY_RING").ok().and_then(|v| {
+                    let mut it = v.split(':'); let n = it.next()?.parse().ok()?; let t = u16::from_str_radix(it.next()?, 16).ok()?; let h = it.next().and_then(|x| u16::from_str_radix(x, 16).ok()).unwrap_or(0xFFFF); Some((n, t, h)) }).unwrap_or((0, 0, 0)));
+                if rg.0 != 0 {
+                    let mut rb = RB.lock().unwrap();
+                    if !rb.3 {
+                        let e = [self.cs, self.ip(), self.a.x(), self.b.x(), self.c.x(), self.d.x(), self.si, self.di, self.ds, self.es, self.ss, self.sp, self.bp];
+                        if rb.0.len() < rg.0 { rb.0.push(e); rb.1.push(self.instruction_count); } else { let k = rb.2; rb.0[k] = e; rb.1[k] = self.instruction_count; }
+                        rb.2 = (rb.2 + 1) % rg.0;
+                        if self.cs >= rg.1 && self.cs < rg.2 {
+                            rb.3 = true;
+                            let k = rb.2; let n = rb.0.len();
+                            for j in 0..n { let r = rb.0[(k + j) % n];
+                                eprintln!("R {:04X}:{:04X} AX:{:04X} BX:{:04X} CX:{:04X} DX:{:04X} SI:{:04X} DI:{:04X} DS:{:04X} ES:{:04X} SS:{:04X} SP:{:04X} BP:{:04X} i{}", r[0],r[1],r[2],r[3],r[4],r[5],r[6],r[7],r[8],r[9],r[10],r[11],r[12], rb.1[(k + j) % n]); }
+                            eprintln!("RING-TRIGGERED");
+                        }
+                    }
+                }
+            }
+            if pw.1 != 0 && self.instruction_count >= pw.0 && self.instruction_count < pw.1 {
+                eprintln!("T {:04X}:{:04X} AX:{:04X} BX:{:04X} CX:{:04X} DX:{:04X} SI:{:04X} DI:{:04X} DS:{:04X} ES:{:04X} SP:{:04X} BP:{:04X} i{}", self.cs, self.ip(), self.a.x(), self.b.x(), self.c.x(), self.d.x(), self.si, self.di, self.ds, self.es, self.sp, self.bp, self.instruction_count);
+            }
+            let ps = PS.get_or_init(|| (
+                std::env::var("MARTY_PCSAMPLE").ok().and_then(|v| v.parse().ok()).unwrap_or(0),
+                std::env::var("MARTY_DUMP_AT").ok().and_then(|v| v.parse().ok()).unwrap_or(0),
+                std::env::var("MARTY_DUMP_FILE").unwrap_or("/tmp/marty_dump.bin".into())));
+            if ps.0 != 0 && self.instruction_count % ps.0 == 0 {
+                eprintln!("PC {:04X}:{:04X} SS:{:04X} SP:{:04X} BP:{:04X} DS:{:04X} ES:{:04X} AX:{:04X} i{}", self.cs, self.ip(), self.ss, self.sp, self.bp, self.ds, self.es, self.a.x(), self.instruction_count);
+                // on-demand dump: create the file named by MARTY_DUMP_NOW (checked at each sample)
+                static DN: std::sync::OnceLock<String> = std::sync::OnceLock::new();
+                let dn = DN.get_or_init(|| std::env::var("MARTY_DUMP_NOW").unwrap_or_default());
+                if !dn.is_empty() && std::path::Path::new(dn).exists() {
+                    let _ = std::fs::remove_file(dn);
+                    let mut v = vec![0u8; 0x100000];
+                    for (i, b) in v.iter_mut().enumerate() { *b = self.bus.peek_u8(i).unwrap_or(0); }
+                    let out = format!("{}.{}", ps.2, self.instruction_count);
+                    let _ = std::fs::write(&out, &v);
+                    eprintln!("DUMPED {} at i{} CS:IP {:04X}:{:04X} SS:SP {:04X}:{:04X} BP:{:04X}", out, self.instruction_count, self.cs, self.ip(), self.ss, self.sp, self.bp);
+                }
+            }
+            if ps.1 != 0 && self.instruction_count == ps.1 {
